{
  "name": "bqat_gui",
  "version": "v0.4.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 9949",
    "build-check": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "build-win": "vue-tsc --noEmit && vite build && electron-builder -w",
    "build-mac": "vue-tsc --noEmit && vite build && electron-builder -m --universal",
    "build-linux": "vite build && electron-builder -l",
    "build-electron": "electron-builder",
    "dist-electron": "electron-builder --dir"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@uppy/compressor": "^2.2.1",
    "@uppy/core": "^4.4.4",
    "@uppy/dashboard": "^4.3.3",
    "@uppy/drag-drop": "^4.1.2",
    "@uppy/file-input": "^4.1.2",
    "@uppy/golden-retriever": "^4.1.1",
    "@uppy/image-editor": "^3.3.2",
    "@uppy/informer": "^4.2.1",
    "@uppy/progress-bar": "^4.2.1",
    "@uppy/remote-sources": "^2.3.2",
    "@uppy/status-bar": "^4.1.3",
    "@uppy/thumbnail-generator": "^4.1.1",
    "@uppy/tus": "^4.2.2",
    "@uppy/vue": "^2.1.1",
    "@uppy/webcam": "^4.1.2",
    "@uppy/xhr-upload": "^4.3.3",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.9.0",
    "bootstrap-icons": "^1.12.1",
    "json-2-csv": "^5.5.9",
    "jszip": "^3.10.1",
    "mime": "^4.0.7",
    "papaparse": "^5.5.2",
    "pinia": "^3.0.2",
    "plotly.js-dist-min": "^3.0.1",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue-sound": "^0.1.10"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.11.0",
    "@tsconfig/node20": "^20.1.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.16",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.1.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.1",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vitest": "^3.1.3",
    "vue-tsc": "^2.2.10"
  },
  "main": "dist-electron/main.js"
}
